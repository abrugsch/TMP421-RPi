[Unit]
Description=TMP421 Temperature Sensor Monitor
Documentation=man:tmp421_monitor.sh(1)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
ExecStart=/home/pi/tmp421_scripts/tmp421_monitor.sh -i 60 -b 1
Restart=on-failure
RestartSec=10

# Security settings
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/tmp421

# Capabilities for I2C access
AmbientCapabilities=CAP_SYS_RAWIO

# Resource limits
CPUQuota=10%
MemoryMax=50M

[Install]
WantedBy=multi-user.target
